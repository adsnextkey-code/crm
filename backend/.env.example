PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRE=30d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required for data to persist reliably on Vercel (serverless has no durable local disk).
# Get a free cluster at https://www.mongodb.com/cloud/atlas, then paste its connection string here
# and in the Vercel project's Environment Variables (Settings > Environment Variables).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agency_crm

MAIL_PROVIDER=outbox
MAIL_FROM=Agency CRM <crm@agency.com>
# RESEND_API_KEY=re_xxx  # for real emails
